# Copy to `.env` and fill in. Never commit the real `.env`.

# Postgres connection string.
#  - Local dev: postgres://postgres:postgres@localhost:5433/registry  (Docker)
#  - Production: your Neon *pooled* connection string.
DATABASE_URL=

# Better Auth — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend) — added in Phase 6.
# RESEND_API_KEY=
# EMAIL_FROM="Registry for Groups <noreply@registryforgroups.com>"
