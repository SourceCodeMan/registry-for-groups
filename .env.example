# Copy to `.env` and fill in. Never commit the real `.env`.

# Postgres connection string.
#  - Local dev: postgres://postgres:postgres@localhost:5433/registry  (Docker)
#  - Production: your Neon *pooled* connection string.
DATABASE_URL=

# Better Auth — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend) — added in Phase 6.
# RESEND_API_KEY=
# EMAIL_FROM="Registry for Groups <noreply@registryforgroups.com>"

# Cloudflare Turnstile captcha (signup + password-reset). Optional: if either
# is unset the captcha is simply inert (no widget, endpoints un-gated). For
# local dev use Cloudflare's test keys (always pass):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Application owner(s): comma-separated emails allowed to see /app/admin.
# Unset means no one can (the page 404s for everyone).
# ADMIN_EMAILS=you@example.com

# Photo uploads (Vercel Blob). Create a Blob store in the Vercel dashboard to
# get the token; set the public flag to "1" to show the "Upload a photo" button.
# Images live in Blob storage (cheap, on a CDN) — only the URL is stored in the
# database. Both unset = uploads hidden, paste-a-link still works.
# BLOB_READ_WRITE_TOKEN=
# NEXT_PUBLIC_UPLOADS_ENABLED=1
