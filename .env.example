# Copy to `.env` and fill in. Never commit the real `.env`.

# Postgres connection string.
#  - Local dev: postgres://postgres:postgres@localhost:5433/registry  (Docker)
#  - Production: your Neon *pooled* connection string.
DATABASE_URL=

# Better Auth — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend) — signup verification, password reset, and invites.
# RESEND_API_KEY=
# EMAIL_FROM="Registry for Groups <noreply@registryforgroups.com>"

# Cloudflare Turnstile captcha (signup + password-reset). Both keys are
# required in production (VERCEL_ENV=production). For local dev, omit both or
# use Cloudflare's test keys (always pass):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Application owner(s): comma-separated emails allowed to see /app/admin.
# Unset means no one can (the page 404s for everyone).
# ADMIN_EMAILS=you@example.com

# Photo uploads (Vercel Blob). Create a Blob store in the Vercel dashboard and
# it sets this automatically — that's all it takes; the "Upload a photo" button
# appears whenever this is present. Images live in Blob storage (cheap, on a
# CDN) — only the URL is stored in the database. Unset = uploads hidden,
# paste-a-link still works.
# BLOB_READ_WRITE_TOKEN=
